/* cell.msw -- Tagged cell constants for the LAM
 *
 * Every value in the LAM is a 24-bit tagged cell:
 *   bits 23-21: tag     (3 bits)  -- term type
 *   bits 20- 0: payload (21 bits) -- address, integer, or packed field
 *
 * See docs/vm-spec.md section 1.
 */

/* Tag values (top 3 bits) */
%DEFINE TAG_REF  0;
%DEFINE TAG_INT  1;
%DEFINE TAG_ATOM 2;
%DEFINE TAG_STR  3;
%DEFINE TAG_LIST 4;
%DEFINE TAG_FUN  5;

/* Arithmetic shift factors (kept for PROC-level fallback) */
%DEFINE TAG_MULT 2097152;
%DEFINE PAYLOAD_MAX 2097151;
%DEFINE FUN_ATOM_MULT 32;
%DEFINE FUN_ARITY_MAX 31;

/* --------------------------------------------------------
 * Cell macros -- COR24 assembly via srl/sll/and/or
 *
 * These avoid software divide entirely by generating
 * shift and mask instructions inline.
 *
 * Parameters are (expr) for source addresses and
 * (lvalue) for destination addresses. Call with ADDR():
 *   ?CELL_GET_TAG(SRC(ADDR(myvar)), DST(ADDR(result)));
 * -------------------------------------------------------- */

/* Extract tag: dst = src >> 21 */
MACRODEF CELL_GET_TAG;
    REQUIRED SRC(expr); REQUIRED DST(lvalue);
    GEN DO;
        'la r0,{SRC}';
        'lw r0,0(r0)';
        'srl r0,r0,21';
        'la r1,{DST}';
        'sw r0,0(r1)';
    END;
END;

/* Extract payload: dst = src & 2097151 */
MACRODEF CELL_GET_PAY;
    REQUIRED SRC(expr); REQUIRED DST(lvalue);
    GEN DO;
        'la r0,{SRC}';
        'lw r0,0(r0)';
        'la r1,2097151';
        'and r0,r0,r1';
        'la r1,{DST}';
        'sw r0,0(r1)';
    END;
END;

/* Build cell: dst = (tag << 21) | payload */
MACRODEF CELL_MAKE;
    REQUIRED TAG(expr); REQUIRED PAY(expr); REQUIRED DST(lvalue);
    GEN DO;
        'la r0,{TAG}';
        'lw r0,0(r0)';
        'sll r0,r0,21';
        'la r1,{PAY}';
        'lw r1,0(r1)';
        'or r0,r0,r1';
        'la r1,{DST}';
        'sw r0,0(r1)';
    END;
END;
