/* vmglob.msw -- Shared VM global declarations
 *
 * Included by all VM modules. Declares the flat memory
 * array and shared working variables.
 */

/* The entire VM address space: 7704 cells of 24-bit words */
DCL MEM(7704) INT;

/* Current instruction word (input to ?INST_DECODE) */
DCL G_INST INT;

/* Decoded instruction fields (set by ?INST_DECODE, read by handlers) */
DCL G_OP INT;
DCL G_OP1 INT;
DCL G_OP2 INT;
DCL G_IMM INT;

/* Scratch globals for macro parameters */
DCL G_TMP INT;
DCL G_TAG INT;
DCL G_PAY INT;

/* Environment stack top (next free cell).
 * EP points to the base of the current frame.
 * G_ET tracks where the next ALLOCATE writes. */
DCL G_ET INT;

/* VM run flag (1 = running, 0 = halted) */
DCL G_RUNNING INT;

/* Note: library modules must use PROC-local STATIC for
 * module-private strings (DCL at top level is suppressed
 * in LIBRARY mode). See PL/SW usage.md lines 369-387. */
