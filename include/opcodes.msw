/* opcodes.msw -- Opcode constants for the LAM
 *
 * Each instruction is 1 or 2 cells wide.
 * Cell 1: bits 23-16 = opcode, 15-8 = op1, 7-0 = op2
 * Cell 2 (if present): 24-bit immediate
 *
 * See docs/vm-spec.md section 3.
 */

/* Control (0-5) */
%DEFINE OP_NOP      0;
%DEFINE OP_HALT     1;
%DEFINE OP_CALL     2;
%DEFINE OP_EXECUTE  3;
%DEFINE OP_PROCEED  4;
%DEFINE OP_FAIL     5;

/* Choice (6-9) */
%DEFINE OP_TRY      6;
%DEFINE OP_RETRY    7;
%DEFINE OP_TRUST    8;

/* PUT family (10-15) */
%DEFINE OP_PUT_VAR   10;
%DEFINE OP_PUT_VAL   11;
%DEFINE OP_PUT_CONST 12;
%DEFINE OP_PUT_Y_VAL 13;

/* GET family (16-21) */
%DEFINE OP_GET_VAR    16;
%DEFINE OP_GET_VAL    17;
%DEFINE OP_GET_CONST  18;
%DEFINE OP_GET_STRUCT 19;
%DEFINE OP_GET_Y_VAR  20;

/* UNIFY family (22-27) */
%DEFINE OP_UNIFY_VAR   22;
%DEFINE OP_UNIFY_VAL   23;
%DEFINE OP_UNIFY_CONST 24;

/* Frame management (28-31) */
%DEFINE OP_ALLOCATE   28;
%DEFINE OP_DEALLOCATE 29;

/* Builtins (32-63) */
%DEFINE OP_B_WRITE  32;
%DEFINE OP_B_NL     33;
%DEFINE OP_B_IS_ADD 34;
%DEFINE OP_B_IS_SUB 35;
%DEFINE OP_B_LT     36;
%DEFINE OP_B_GT     37;

/* Arithmetic decode factors (kept for PROC-level fallback) */
%DEFINE OP_MULT  65536;
%DEFINE OP1_MULT 256;

/* --------------------------------------------------------
 * Instruction decode macro -- COR24 assembly
 *
 * Splits a 24-bit instruction cell into G_OP, G_OP1, G_OP2
 * using shifts and masks. No software divide.
 *
 * SRC is the address of the instruction word.
 * Results written to globals G_OP, G_OP1, G_OP2.
 *
 *   ?INST_DECODE(SRC(ADDR(G_INST)));
 * -------------------------------------------------------- */

MACRODEF INST_DECODE;
    REQUIRED SRC(expr);
    GEN DO;
        'la r0,{SRC}';
        'lw r0,0(r0)';
        /* opcode = bits 23-16 */
        'srl r1,r0,16';
        'la r2,G_OP';
        'sw r1,0(r2)';
        /* op1 = bits 15-8 */
        'srl r1,r0,8';
        'la r2,255';
        'and r1,r1,r2';
        'la r2,G_OP1';
        'sw r1,0(r2)';
        /* op2 = bits 7-0 */
        'la r1,255';
        'and r0,r0,r1';
        'la r1,G_OP2';
        'sw r0,0(r1)';
    END;
END;
