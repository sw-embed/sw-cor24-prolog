/* vm_main.plsw -- LAM Virtual Machine entry point
 *
 * Contains VM_INIT, VM_RUN dispatch loop, and MAIN.
 * Runtime primitives are in separate library modules:
 *   vm_regs.plsw   -- REG_GET, REG_SET
 *   vm_heap.plsw   -- cell helpers, heap, deref, bind, trail
 *   vm_choice.plsw -- choice-point push/restore/pop
 *   vm_io.plsw     -- PRINT_INT, VM_TRACE, atom table
 *   vm_tests.plsw  -- test program loaders
 *
 * Build:
 *   pipeline.sh include/cell.msw include/memory.msw \
 *     include/opcodes.msw include/frames.msw \
 *     include/vmglob.msw \
 *     src/vm/vm_regs.plsw src/vm/vm_heap.plsw \
 *     src/vm/vm_choice.plsw src/vm/vm_io.plsw \
 *     src/vm/vm_tests.plsw src/vm/vm_main.plsw
 */

%INCLUDE cell;
%INCLUDE memory;
%INCLUDE opcodes;
%INCLUDE frames;
%INCLUDE vmglob;

/* --------------------------------------------------------
 * VM initialization
 * -------------------------------------------------------- */

VM_INIT: PROC;
    DCL I INT;

    /* Zero all memory */
    DO I = 0 TO 7703;
        MEM(I) = 0;
    END;

    /* Populate atom table */
    CALL ATOM_INIT;

    /* Set initial register values */
    CALL REG_SET(REG_PC, CODE_BASE);
    CALL REG_SET(REG_HP, HEAP_BASE);
    CALL REG_SET(REG_TR, TRAIL_BASE);
    CALL REG_SET(REG_EP, ENV_BASE);
    G_ET = ENV_BASE;
    CALL REG_SET(REG_BP, CP_BASE);
    CALL REG_SET(REG_MODE, 0);
END;

/* --------------------------------------------------------
 * Fetch / decode / dispatch loop
 * -------------------------------------------------------- */

VM_RUN: PROC;
    DCL PC INT;
    DCL IMM INT;
    DCL REGVAL INT;

    G_RUNNING = 1;

    DO WHILE (G_RUNNING = 1);
        PC = REG_GET(REG_PC);
        G_INST = MEM(PC);
        ?INST_DECODE(SRC(ADDR(G_INST)));
        CALL VM_TRACE(PC, G_OP);

        SELECT;
            WHEN (G_OP = OP_NOP) DO;
                CALL REG_SET(REG_PC, PC + 1);
            END;

            WHEN (G_OP = OP_HALT) DO;
                CALL UART_PUTS(ADDR(M_HALT));
                G_RUNNING = 0;
            END;

            /* PUT_CONST Ai, [imm] -- 2-cell */
            WHEN (G_OP = OP_PUT_CONST) DO;
                IMM = MEM(PC + 1);
                CALL REG_SET(G_OP1, IMM);
                CALL REG_SET(REG_PC, PC + 2);
            END;

            /* PUT_VAR Xn, Ai -- 1-cell */
            WHEN (G_OP = OP_PUT_VAR) DO;
                DCL PV_ADDR INT;
                DCL PV_REF INT;
                PV_ADDR = HEAP_ALLOC();
                PV_REF = MAKE_CELL(TAG_REF, PV_ADDR);
                MEM(PV_ADDR) = PV_REF;
                CALL REG_SET(G_OP1, PV_REF);
                CALL REG_SET(G_OP2, PV_REF);
                CALL REG_SET(REG_PC, PC + 1);
            END;

            /* PUT_VAL Xn, Ai -- 1-cell
             * Copy Xn to Ai (pass existing value to next goal). */
            WHEN (G_OP = OP_PUT_VAL) DO;
                CALL REG_SET(G_OP2, REG_GET(G_OP1));
                CALL REG_SET(REG_PC, PC + 1);
            END;

            /* PUT_Y_VAL Yi, Ai -- 1-cell
             * Copy Y[op1] from environment frame to Ai. */
            WHEN (G_OP = OP_PUT_Y_VAL) DO;
                CALL REG_SET(G_OP2, Y_GET(G_OP1));
                CALL REG_SET(REG_PC, PC + 1);
            END;

            /* GET_VAR Xn, Ai -- 1-cell */
            WHEN (G_OP = OP_GET_VAR) DO;
                CALL REG_SET(G_OP1, REG_GET(G_OP2));
                CALL REG_SET(REG_PC, PC + 1);
            END;

            /* GET_Y_VAR Yi, Ai -- 1-cell
             * Copy Ai to Y[op1] in environment frame. */
            WHEN (G_OP = OP_GET_Y_VAR) DO;
                CALL Y_SET(G_OP1, REG_GET(G_OP2));
                CALL REG_SET(REG_PC, PC + 1);
            END;

            /* GET_CONST Ai, [imm] -- 2-cell */
            WHEN (G_OP = OP_GET_CONST) DO;
                IMM = MEM(PC + 1);
                REGVAL = DEREF(REG_GET(G_OP1));
                IF (IS_UNBOUND(REGVAL) = 1) THEN DO;
                    CALL BIND(CELL_PAY(REGVAL), IMM);
                    CALL REG_SET(REG_PC, PC + 2);
                END;
                ELSE DO;
                    IF (REGVAL = IMM) THEN DO;
                        CALL REG_SET(REG_PC, PC + 2);
                    END;
                    ELSE DO;
                        IF (REG_GET(REG_BP) = CP_BASE) THEN DO;
                            CALL UART_PUTS(ADDR(M_FAIL));
                            G_RUNNING = 0;
                        END;
                        ELSE DO;
                            CALL REG_SET(REG_PC, CP_RESTORE());
                        END;
                    END;
                END;
            END;

            /* CALL [imm] -- 2-cell */
            WHEN (G_OP = OP_CALL) DO;
                CALL REG_SET(REG_CP, PC + 2);
                IMM = MEM(PC + 1);
                CALL REG_SET(REG_PC, IMM);
            END;

            /* EXECUTE [imm] -- 2-cell (tail call, no CP save) */
            WHEN (G_OP = OP_EXECUTE) DO;
                IMM = MEM(PC + 1);
                CALL REG_SET(REG_PC, IMM);
            END;

            /* PROCEED -- 1-cell */
            WHEN (G_OP = OP_PROCEED) DO;
                CALL REG_SET(REG_PC, REG_GET(REG_CP));
            END;

            /* TRY [imm] -- 2-cell */
            WHEN (G_OP = OP_TRY) DO;
                IMM = MEM(PC + 1);
                CALL CP_PUSH(IMM);
                CALL REG_SET(REG_PC, PC + 2);
            END;

            /* RETRY [imm] -- 2-cell
             * Middle alternative: restore from choice point,
             * update next_alt to [imm], fall through. */
            WHEN (G_OP = OP_RETRY) DO;
                DCL RT_DUMMY INT;
                DCL RT_FB INT;
                RT_DUMMY = CP_RESTORE();
                /* Update next_alt in the current frame */
                RT_FB = REG_GET(REG_BP) - CP_FRAME_SIZE;
                IMM = MEM(PC + 1);
                CALL CP_WRITE(RT_FB, CPF_NEXT_ALT, IMM);
                CALL REG_SET(REG_PC, PC + 2);
            END;

            /* TRUST -- 1-cell */
            WHEN (G_OP = OP_TRUST) DO;
                DCL TR_DUMMY INT;
                TR_DUMMY = CP_POP();
                CALL REG_SET(REG_PC, PC + 1);
            END;

            /* CUT -- 1-cell
             * Remove all choice points (blunt CUT).
             * Sets BP = CP_BASE. A proper WAM CUT would
             * restore to the BP at predicate entry; this
             * simplified version is noted as a limitation. */
            WHEN (G_OP = OP_CUT) DO;
                CALL REG_SET(REG_BP, CP_BASE);
                CALL REG_SET(REG_PC, PC + 1);
            END;

            /* ALLOCATE n -- 1-cell (op1 = n local slots)
             * Push environment frame: save EP and CP,
             * reserve n slots for local variables Y0..Yn-1. */
            WHEN (G_OP = OP_ALLOCATE) DO;
                IF (G_ET + ENV_HDR_SIZE + G_OP1 > ENV_BASE + ENV_SIZE) THEN DO;
                    CALL UART_PUTS(ADDR(M_ENVOV));
                    G_RUNNING = 0;
                END;
                ELSE DO;
                    MEM(G_ET + ENV_PREV_EP) = REG_GET(REG_EP);
                    MEM(G_ET + ENV_SAVED_CP) = REG_GET(REG_CP);
                    CALL REG_SET(REG_EP, G_ET);
                    G_ET = G_ET + ENV_HDR_SIZE + G_OP1;
                    CALL REG_SET(REG_PC, PC + 1);
                END;
            END;

            /* DEALLOCATE -- 1-cell
             * Pop environment frame: restore CP and EP. */
            WHEN (G_OP = OP_DEALLOCATE) DO;
                DCL D_EP INT;
                D_EP = REG_GET(REG_EP);
                CALL REG_SET(REG_CP, MEM(D_EP + ENV_SAVED_CP));
                G_ET = D_EP;
                CALL REG_SET(REG_EP, MEM(D_EP + ENV_PREV_EP));
                CALL REG_SET(REG_PC, PC + 1);
            END;

            /* FAIL -- 1-cell */
            WHEN (G_OP = OP_FAIL) DO;
                IF (REG_GET(REG_BP) = CP_BASE) THEN DO;
                    CALL UART_PUTS(ADDR(M_FAIL));
                    G_RUNNING = 0;
                END;
                ELSE DO;
                    DCL FAIL_ALT INT;
                    FAIL_ALT = CP_RESTORE();
                    CALL REG_SET(REG_PC, FAIL_ALT);
                END;
            END;

            /* B_WRITE Ai -- 1-cell */
            WHEN (G_OP = OP_B_WRITE) DO;
                DCL WVAL INT;
                DCL WTAG INT;
                DCL WPAY INT;
                WVAL = DEREF(REG_GET(G_OP1));
                WTAG = CELL_TAG(WVAL);
                WPAY = CELL_PAY(WVAL);
                SELECT;
                    WHEN (WTAG = TAG_ATOM) DO;
                        CALL ATOM_PRINT(WPAY);
                    END;
                    WHEN (WTAG = TAG_INT) DO;
                        CALL PRINT_INT(WPAY);
                    END;
                    WHEN (WTAG = TAG_REF) DO;
                        CALL UART_PUTCHAR(95);
                        CALL UART_PUTCHAR(86);
                        CALL PRINT_INT(WPAY);
                    END;
                    OTHERWISE DO;
                        CALL PRINT_INT(WVAL);
                    END;
                END;
                CALL REG_SET(REG_PC, PC + 1);
            END;

            /* B_NL -- 1-cell */
            WHEN (G_OP = OP_B_NL) DO;
                CALL UART_PUTCHAR(10);
                CALL REG_SET(REG_PC, PC + 1);
            END;

            /* B_IS_ADD -- 1-cell
             * A0 = A1 + A2 (INT payloads). */
            WHEN (G_OP = OP_B_IS_ADD) DO;
                DCL ADD_L INT;
                DCL ADD_R INT;
                ADD_L = CELL_PAY(DEREF(REG_GET(REG_A1)));
                ADD_R = CELL_PAY(DEREF(REG_GET(REG_A2)));
                CALL REG_SET(REG_A0, MAKE_CELL(TAG_INT, ADD_L + ADD_R));
                CALL REG_SET(REG_PC, PC + 1);
            END;

            /* B_IS_SUB -- 1-cell
             * A0 = A1 - A2 (INT payloads). */
            WHEN (G_OP = OP_B_IS_SUB) DO;
                DCL SUB_L INT;
                DCL SUB_R INT;
                SUB_L = CELL_PAY(DEREF(REG_GET(REG_A1)));
                SUB_R = CELL_PAY(DEREF(REG_GET(REG_A2)));
                CALL REG_SET(REG_A0, MAKE_CELL(TAG_INT, SUB_L - SUB_R));
                CALL REG_SET(REG_PC, PC + 1);
            END;

            /* B_LT -- 1-cell
             * Succeed if A0 < A1 (INT payloads). Fail otherwise. */
            WHEN (G_OP = OP_B_LT) DO;
                DCL LT_L INT;
                DCL LT_R INT;
                LT_L = CELL_PAY(DEREF(REG_GET(REG_A0)));
                LT_R = CELL_PAY(DEREF(REG_GET(REG_A1)));
                IF (LT_L < LT_R) THEN DO;
                    CALL REG_SET(REG_PC, PC + 1);
                END;
                ELSE DO;
                    IF (REG_GET(REG_BP) = CP_BASE) THEN DO;
                        CALL UART_PUTS(ADDR(M_FAIL));
                        G_RUNNING = 0;
                    END;
                    ELSE DO;
                        CALL REG_SET(REG_PC, CP_RESTORE());
                    END;
                END;
            END;

            /* B_GT -- 1-cell
             * Succeed if A0 > A1 (INT payloads). Fail otherwise. */
            WHEN (G_OP = OP_B_GT) DO;
                DCL GT_L INT;
                DCL GT_R INT;
                GT_L = CELL_PAY(DEREF(REG_GET(REG_A0)));
                GT_R = CELL_PAY(DEREF(REG_GET(REG_A1)));
                IF (GT_L > GT_R) THEN DO;
                    CALL REG_SET(REG_PC, PC + 1);
                END;
                ELSE DO;
                    IF (REG_GET(REG_BP) = CP_BASE) THEN DO;
                        CALL UART_PUTS(ADDR(M_FAIL));
                        G_RUNNING = 0;
                    END;
                    ELSE DO;
                        CALL REG_SET(REG_PC, CP_RESTORE());
                    END;
                END;
            END;

            OTHERWISE DO;
                CALL UART_PUTS(ADDR(M_BADOP));
                CALL PRINT_INT(G_OP);
                CALL UART_PUTCHAR(10);
                G_RUNNING = 0;
            END;
        END;
    END;
END;

/* --------------------------------------------------------
 * Messages
 * -------------------------------------------------------- */

DCL M_INIT(12) CHAR INIT('LAM v0.2   ');
DCL M_HALT(7) CHAR  INIT('HALT  ');
DCL M_FAIL(7) CHAR  INIT('FAIL  ');
DCL M_BADOP(12) CHAR  INIT('Bad opcode ');
DCL M_ENVOV(15) CHAR INIT('Env overflow  ');

/* --------------------------------------------------------
 * Test labels and display helpers
 * -------------------------------------------------------- */

DCL M_TEST1(20) CHAR INIT('--- fact_lookup ---');
DCL M_TEST2(20) CHAR INIT('--- fact_fail  ---');
DCL M_TEST3(20) CHAR INIT('--- put_var    ---');
DCL M_TEST4(20) CHAR INIT('--- deref_bind ---');
DCL M_TEST5(20) CHAR INIT('--- unify_var  ---');
DCL M_TEST6(20) CHAR INIT('--- trail      ---');
DCL M_TEST7(20) CHAR INIT('--- try/trust  ---');
DCL M_TEST8(20) CHAR INIT('--- backtrack  ---');
DCL M_TEST9(20) CHAR INIT('--- two_facts  ---');
DCL M_TESTA(20) CHAR INIT('--- alloc/dealloc-');
DCL M_TESTB(20) CHAR INIT('--- ancestor    ---');
DCL M_TESTC(20) CHAR INIT('--- ancestor X  ---');
DCL M_TESTD(20) CHAR INIT('--- retry 3cls  ---');
DCL M_TESTE(20) CHAR INIT('--- arithmetic  ---');
DCL M_TESTF(20) CHAR INIT('--- cut         ---');
DCL M_TESTG(24) CHAR INIT('--- compiled parent ---');
DCL M_BP(5) CHAR    INIT(' BP=');
DCL M_TR(5) CHAR    INIT(' TR=');
DCL M_A0(5) CHAR    INIT(' A0=');
DCL M_A1(5) CHAR    INIT(' A1=');
DCL M_HP(5) CHAR    INIT(' HP=');
DCL M_HEAP(8) CHAR  INIT(' H[0]=');
DCL M_UB(5) CHAR    INIT(' ub=');
DCL M_DR(5) CHAR    INIT(' dr=');

/* --------------------------------------------------------
 * Entry point
 * -------------------------------------------------------- */

MAIN: PROC;
    DCL VAR_ADDR INT;
    DCL VAR_REF INT;
    DCL ATOM_ANN INT;
    DCL UB INT;
    DCL DR INT;
    DCL V1_ADDR INT;
    DCL V1_REF INT;
    DCL V2_ADDR INT;
    DCL V2_REF INT;
    DCL SAVED_TR INT;

    CALL UART_PUTS(ADDR(M_INIT));
    CALL UART_PUTCHAR(10);

    /* Test 1: fact_lookup -- should succeed */
    CALL UART_PUTS(ADDR(M_TEST1));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;
    CALL LOAD_FACT_LOOKUP;
    CALL VM_RUN;
    CALL UART_PUTCHAR(10);

    /* Test 2: fact_fail -- should fail */
    CALL UART_PUTS(ADDR(M_TEST2));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;
    CALL LOAD_FACT_FAIL;
    CALL VM_RUN;
    CALL UART_PUTCHAR(10);

    /* Test 3: put_var */
    CALL UART_PUTS(ADDR(M_TEST3));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;
    CALL LOAD_PUT_VAR_TEST;
    CALL VM_RUN;
    CALL UART_PUTS(ADDR(M_A0));
    CALL PRINT_INT(REG_GET(REG_A0));
    CALL UART_PUTS(ADDR(M_A1));
    CALL PRINT_INT(REG_GET(REG_A1));
    CALL UART_PUTS(ADDR(M_HP));
    CALL PRINT_INT(REG_GET(REG_HP));
    CALL UART_PUTS(ADDR(M_HEAP));
    CALL PRINT_INT(MEM(HEAP_BASE));
    CALL UART_PUTCHAR(10);

    /* Test 4: deref_bind (manual, no VM_RUN) */
    CALL UART_PUTS(ADDR(M_TEST4));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;

    VAR_ADDR = HEAP_ALLOC();
    VAR_REF = MAKE_CELL(TAG_REF, VAR_ADDR);
    MEM(VAR_ADDR) = VAR_REF;

    UB = IS_UNBOUND(VAR_REF);
    CALL UART_PUTS(ADDR(M_UB));
    CALL PRINT_INT(UB);

    ATOM_ANN = MAKE_CELL(TAG_ATOM, 2);
    CALL BIND(VAR_ADDR, ATOM_ANN);

    UB = IS_UNBOUND(VAR_REF);
    CALL UART_PUTS(ADDR(M_UB));
    CALL PRINT_INT(UB);

    DR = DEREF(VAR_REF);
    CALL UART_PUTS(ADDR(M_DR));
    CALL PRINT_INT(DR);
    CALL UART_PUTCHAR(10);

    /* Test 5: unify_var */
    CALL UART_PUTS(ADDR(M_TEST5));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;
    CALL LOAD_UNIFY_TEST;
    CALL VM_RUN;
    DR = DEREF(REG_GET(REG_A1));
    CALL UART_PUTS(ADDR(M_A1));
    CALL PRINT_INT(DR);
    CALL UART_PUTCHAR(10);

    /* Test 6: trail push and unwind */
    CALL UART_PUTS(ADDR(M_TEST6));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;

    SAVED_TR = REG_GET(REG_TR);

    V1_ADDR = HEAP_ALLOC();
    V1_REF = MAKE_CELL(TAG_REF, V1_ADDR);
    MEM(V1_ADDR) = V1_REF;

    V2_ADDR = HEAP_ALLOC();
    V2_REF = MAKE_CELL(TAG_REF, V2_ADDR);
    MEM(V2_ADDR) = V2_REF;

    CALL BIND(V1_ADDR, MAKE_CELL(TAG_ATOM, 1));
    CALL BIND(V2_ADDR, MAKE_CELL(TAG_ATOM, 2));

    CALL UART_PUTS(ADDR(M_TR));
    CALL PRINT_INT(REG_GET(REG_TR));
    CALL UART_PUTS(ADDR(M_DR));
    CALL PRINT_INT(DEREF(V1_REF));
    CALL UART_PUTS(ADDR(M_DR));
    CALL PRINT_INT(DEREF(V2_REF));

    CALL TRAIL_UNWIND(SAVED_TR);

    CALL UART_PUTS(ADDR(M_TR));
    CALL PRINT_INT(REG_GET(REG_TR));
    CALL UART_PUTS(ADDR(M_UB));
    CALL PRINT_INT(IS_UNBOUND(V1_REF));
    CALL UART_PUTS(ADDR(M_UB));
    CALL PRINT_INT(IS_UNBOUND(V2_REF));
    CALL UART_PUTCHAR(10);

    /* Test 7: try/trust */
    CALL UART_PUTS(ADDR(M_TEST7));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;
    CALL LOAD_TRY_TEST;
    CALL UART_PUTS(ADDR(M_BP));
    CALL PRINT_INT(REG_GET(REG_BP));
    CALL VM_RUN;
    CALL UART_PUTS(ADDR(M_BP));
    CALL PRINT_INT(REG_GET(REG_BP));
    CALL UART_PUTS(ADDR(M_A0));
    CALL PRINT_INT(REG_GET(REG_A0));
    CALL UART_PUTCHAR(10);

    /* Test 8: backtracking */
    CALL UART_PUTS(ADDR(M_TEST8));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;
    CALL LOAD_BACKTRACK_TEST;
    CALL VM_RUN;
    CALL UART_PUTS(ADDR(M_A0));
    CALL PRINT_INT(REG_GET(REG_A0));
    CALL UART_PUTCHAR(10);

    /* Test 9: two_facts milestone */
    CALL UART_PUTS(ADDR(M_TEST9));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;
    CALL LOAD_TWO_FACTS;
    CALL VM_RUN;
    CALL UART_PUTCHAR(10);

    /* Test 10: allocate/deallocate
     * wrap(X) :- parent(X, Y). with parent(bob, ann).
     * Query: ?- wrap(bob).
     * ALLOCATE saves CP, CALL parent succeeds,
     * DEALLOCATE restores CP, PROCEED returns to HALT.
     */
    CALL UART_PUTS(ADDR(M_TESTA));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;
    CALL LOAD_ALLOC_TEST;
    CALL VM_RUN;
    CALL UART_PUTCHAR(10);

    /* Test 11: ancestor/2 with recursion
     * ancestor(bob, liz) via parent(bob,ann) + parent(ann,liz).
     * Exercises: TRY/TRUST, EXECUTE (tail call), ALLOCATE/DEALLOCATE,
     * GET_Y_VAR/PUT_Y_VAL (Y registers), recursion.
     * Should print HALT on success.
     */
    CALL UART_PUTS(ADDR(M_TESTB));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;
    CALL LOAD_ANCESTOR_TEST;
    CALL VM_RUN;
    CALL UART_PUTCHAR(10);

    /* Test 12: ancestor(bob, X) -- find all answers
     * Expected output:
     *   ann
     *   liz
     *   FAIL
     */
    CALL UART_PUTS(ADDR(M_TESTC));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;
    CALL LOAD_ANCESTOR_ALL;
    CALL VM_RUN;
    CALL UART_PUTCHAR(10);

    /* Test 13: RETRY -- 3-clause predicate
     * color(red). color(green). color(blue).
     * ?- color(X), write(X), nl, fail.
     * Expected: red green blue FAIL
     */
    CALL UART_PUTS(ADDR(M_TESTD));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;
    CALL LOAD_RETRY_TEST;
    CALL VM_RUN;
    CALL UART_PUTCHAR(10);

    /* Test 14: arithmetic
     * 3 + 4 = 7, print 7.
     * 3 < 7 succeeds, 7 < 3 fails.
     * Expected: prints 7, then FAIL.
     */
    CALL UART_PUTS(ADDR(M_TESTE));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;
    CALL LOAD_ARITH_TEST;
    CALL VM_RUN;
    CALL UART_PUTCHAR(10);

    /* Test 15: CUT prevents backtracking
     * first(X) :- color(X), !.
     * Expected: prints red only, then FAIL (CUT removed CPs).
     */
    CALL UART_PUTS(ADDR(M_TESTF));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;
    CALL LOAD_CUT_TEST;
    CALL VM_RUN;
    CALL UART_PUTCHAR(10);

    /* Test 16: Compiled Prolog program (parent.pl)
     * Bytecode produced by src/prolog/codegen.sno.
     * PC=0 is EXECUTE query, jumps to query setup.
     */
    CALL UART_PUTS(ADDR(M_TESTG));
    CALL UART_PUTCHAR(10);
    CALL VM_INIT;
    CALL LOAD_PARENT_COMPILED;
    CALL VM_RUN;
    CALL UART_PUTCHAR(10);
END;
