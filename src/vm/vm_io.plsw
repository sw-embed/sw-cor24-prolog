/* vm_io.plsw -- I/O, trace, and atom table operations
 *
 * PRINT_INT, VM_TRACE, atom table store/init/print.
 */
%DEFINE LIBRARY;

%INCLUDE memory;
%INCLUDE vmglob;

/* --------------------------------------------------------
 * Integer printing
 * -------------------------------------------------------- */

PRINT_INT: PROC(N INT);
    DCL D INT;
    DCL R INT;
    DCL BUF(8) CHAR;
    DCL POS INT;
    DCL NEG INT;

    IF (N = 0) THEN DO;
        CALL UART_PUTCHAR(48);
        RETURN;
    END;

    NEG = 0;
    IF (N < 0) THEN DO;
        NEG = 1;
        N = 0 - N;
    END;

    POS = 7;
    BUF(POS) = 0;
    DO WHILE (N > 0);
        POS = POS - 1;
        D = N / 10;
        R = N - D * 10;
        BUF(POS) = R + 48;
        N = D;
    END;

    IF (NEG = 1) THEN DO;
        POS = POS - 1;
        BUF(POS) = 45;
    END;

    CALL UART_PUTS(ADDR(BUF) + POS);
END;

VM_TRACE: PROC(PC INT, OP INT);
    DCL T_MSG(4) CHAR STATIC INIT('PC=');
    DCL T_SEP(5) CHAR STATIC INIT(' op=');
    CALL UART_PUTS(ADDR(T_MSG));
    CALL PRINT_INT(PC);
    CALL UART_PUTS(ADDR(T_SEP));
    CALL PRINT_INT(OP);
    CALL UART_PUTCHAR(10);
END;

/* --------------------------------------------------------
 * Atom table
 * -------------------------------------------------------- */

ATOM_STORE: PROC(ID INT, C0 INT, C1 INT, C2 INT, C3 INT,
                  C4 INT, C5 INT, C6 INT);
    DCL BASE INT;
    BASE = ATOM_BASE + ID * ATOM_SLOT_SIZE;
    MEM(BASE)     = C0;
    MEM(BASE + 1) = C1;
    MEM(BASE + 2) = C2;
    MEM(BASE + 3) = C3;
    MEM(BASE + 4) = C4;
    MEM(BASE + 5) = C5;
    MEM(BASE + 6) = C6;
    MEM(BASE + 7) = 0;
END;

ATOM_INIT: PROC;
    /* 0: []       */  CALL ATOM_STORE(0, 91, 93, 0, 0, 0, 0, 0);
    /* 1: bob      */  CALL ATOM_STORE(1, 98, 111, 98, 0, 0, 0, 0);
    /* 2: ann      */  CALL ATOM_STORE(2, 97, 110, 110, 0, 0, 0, 0);
    /* 3: joe      */  CALL ATOM_STORE(3, 106, 111, 101, 0, 0, 0, 0);
    /* 4: liz      */  CALL ATOM_STORE(4, 108, 105, 122, 0, 0, 0, 0);
    /* 5: parent   */  CALL ATOM_STORE(5, 112, 97, 114, 101, 110, 116, 0);
    /* 6: ancestor */  CALL ATOM_STORE(6, 97, 110, 99, 101, 115, 116, 111);
    /* 7: red      */  CALL ATOM_STORE(7, 114, 101, 100, 0, 0, 0, 0);
    /* 8: green    */  CALL ATOM_STORE(8, 103, 114, 101, 101, 110, 0, 0);
    /* 9: blue     */  CALL ATOM_STORE(9, 98, 108, 117, 101, 0, 0, 0);
END;

ATOM_PRINT: PROC(ID INT);
    DCL BASE INT;
    DCL I INT;
    DCL CH INT;
    BASE = ATOM_BASE + ID * ATOM_SLOT_SIZE;
    I = 0;
    CH = MEM(BASE);
    DO WHILE (CH != 0 AND I < ATOM_SLOT_SIZE);
        CALL UART_PUTCHAR(CH);
        I = I + 1;
        CH = MEM(BASE + I);
    END;
END;

MAIN: PROC;
END;
