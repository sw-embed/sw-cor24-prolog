/* vm_tests.plsw -- Test program loaders for the LAM VM
 *
 * Each LOAD_* proc writes bytecode into the code area.
 * Called from MAIN in vm_main.plsw.
 */
%DEFINE LIBRARY;

%INCLUDE cell;
%INCLUDE memory;
%INCLUDE opcodes;
%INCLUDE frames;
%INCLUDE vmglob;

/* --------------------------------------------------------
 * Test 1: fact_lookup
 * parent(bob, ann).  ?- parent(bob, ann).
 * -------------------------------------------------------- */

LOAD_FACT_LOOKUP: PROC;
    MEM(0)  = OP_PUT_CONST * OP_MULT;
    MEM(1)  = TAG_ATOM * TAG_MULT + 1;
    MEM(2)  = OP_PUT_CONST * OP_MULT + 1 * OP1_MULT;
    MEM(3)  = TAG_ATOM * TAG_MULT + 2;
    MEM(4)  = OP_CALL * OP_MULT;
    MEM(5)  = 8;
    MEM(6)  = OP_HALT * OP_MULT;

    MEM(8)  = OP_GET_CONST * OP_MULT;
    MEM(9)  = TAG_ATOM * TAG_MULT + 1;
    MEM(10) = OP_GET_CONST * OP_MULT + 1 * OP1_MULT;
    MEM(11) = TAG_ATOM * TAG_MULT + 2;
    MEM(12) = OP_PROCEED * OP_MULT;
END;

/* --------------------------------------------------------
 * Test 2: fact_fail
 * parent(bob, ann).  ?- parent(bob, joe).  -- should fail
 * -------------------------------------------------------- */

LOAD_FACT_FAIL: PROC;
    MEM(0)  = OP_PUT_CONST * OP_MULT;
    MEM(1)  = TAG_ATOM * TAG_MULT + 1;
    MEM(2)  = OP_PUT_CONST * OP_MULT + 1 * OP1_MULT;
    MEM(3)  = TAG_ATOM * TAG_MULT + 3;
    MEM(4)  = OP_CALL * OP_MULT;
    MEM(5)  = 8;
    MEM(6)  = OP_HALT * OP_MULT;

    MEM(8)  = OP_GET_CONST * OP_MULT;
    MEM(9)  = TAG_ATOM * TAG_MULT + 1;
    MEM(10) = OP_GET_CONST * OP_MULT + 1 * OP1_MULT;
    MEM(11) = TAG_ATOM * TAG_MULT + 2;
    MEM(12) = OP_PROCEED * OP_MULT;
END;

/* --------------------------------------------------------
 * Test 3: put_var
 * PUT_CONST A0 bob, PUT_VAR X0 A1, HALT
 * -------------------------------------------------------- */

LOAD_PUT_VAR_TEST: PROC;
    MEM(0) = OP_PUT_CONST * OP_MULT;
    MEM(1) = TAG_ATOM * TAG_MULT + 1;
    MEM(2) = OP_PUT_VAR * OP_MULT + REG_X0 * OP1_MULT + REG_A1;
    MEM(3) = OP_HALT * OP_MULT;
END;

/* --------------------------------------------------------
 * Test 5: unify_var
 * parent(bob, X) against parent(bob, ann). Binds X=ann.
 * -------------------------------------------------------- */

LOAD_UNIFY_TEST: PROC;
    MEM(0)  = OP_PUT_CONST * OP_MULT;
    MEM(1)  = TAG_ATOM * TAG_MULT + 1;
    MEM(2)  = OP_PUT_VAR * OP_MULT + REG_X0 * OP1_MULT + REG_A1;
    MEM(3)  = OP_CALL * OP_MULT;
    MEM(4)  = 7;
    MEM(5)  = OP_HALT * OP_MULT;

    MEM(7)  = OP_GET_CONST * OP_MULT;
    MEM(8)  = TAG_ATOM * TAG_MULT + 1;
    MEM(9)  = OP_GET_CONST * OP_MULT + 1 * OP1_MULT;
    MEM(10) = TAG_ATOM * TAG_MULT + 2;
    MEM(11) = OP_PROCEED * OP_MULT;
END;

/* --------------------------------------------------------
 * Test 7: try/trust
 * pred(bob)/pred(ann), query pred(bob). First clause matches.
 * -------------------------------------------------------- */

LOAD_TRY_TEST: PROC;
    MEM(0)  = OP_PUT_CONST * OP_MULT;
    MEM(1)  = TAG_ATOM * TAG_MULT + 1;
    MEM(2)  = OP_CALL * OP_MULT;
    MEM(3)  = 6;
    MEM(4)  = OP_HALT * OP_MULT;

    MEM(6)  = OP_TRY * OP_MULT;
    MEM(7)  = 12;

    MEM(8)  = OP_GET_CONST * OP_MULT;
    MEM(9)  = TAG_ATOM * TAG_MULT + 1;
    MEM(10) = OP_PROCEED * OP_MULT;

    MEM(12) = OP_TRUST * OP_MULT;
    MEM(13) = OP_GET_CONST * OP_MULT;
    MEM(14) = TAG_ATOM * TAG_MULT + 2;
    MEM(15) = OP_PROCEED * OP_MULT;
END;

/* --------------------------------------------------------
 * Test 8: backtrack
 * pred(bob)/pred(ann), query pred(ann). Backtracks to clause2.
 * -------------------------------------------------------- */

LOAD_BACKTRACK_TEST: PROC;
    MEM(0)  = OP_PUT_CONST * OP_MULT;
    MEM(1)  = TAG_ATOM * TAG_MULT + 2;
    MEM(2)  = OP_CALL * OP_MULT;
    MEM(3)  = 6;
    MEM(4)  = OP_HALT * OP_MULT;

    MEM(6)  = OP_TRY * OP_MULT;
    MEM(7)  = 12;

    MEM(8)  = OP_GET_CONST * OP_MULT;
    MEM(9)  = TAG_ATOM * TAG_MULT + 1;
    MEM(10) = OP_PROCEED * OP_MULT;

    MEM(12) = OP_TRUST * OP_MULT;
    MEM(13) = OP_GET_CONST * OP_MULT;
    MEM(14) = TAG_ATOM * TAG_MULT + 2;
    MEM(15) = OP_PROCEED * OP_MULT;
END;

/* --------------------------------------------------------
 * Test 9: two_facts
 * parent(bob,ann). parent(bob,joe).
 * ?- parent(bob, X), write(X), nl, fail.
 * -------------------------------------------------------- */

LOAD_TWO_FACTS: PROC;
    MEM(0)  = OP_PUT_CONST * OP_MULT;
    MEM(1)  = TAG_ATOM * TAG_MULT + 1;
    MEM(2)  = OP_PUT_VAR * OP_MULT + REG_X0 * OP1_MULT + REG_A1;
    MEM(3)  = OP_CALL * OP_MULT;
    MEM(4)  = 10;
    MEM(5)  = OP_B_WRITE * OP_MULT + REG_A1 * OP1_MULT;
    MEM(6)  = OP_B_NL * OP_MULT;
    MEM(7)  = OP_FAIL * OP_MULT;

    MEM(10) = OP_TRY * OP_MULT;
    MEM(11) = 19;

    MEM(12) = OP_GET_CONST * OP_MULT;
    MEM(13) = TAG_ATOM * TAG_MULT + 1;
    MEM(14) = OP_GET_CONST * OP_MULT + REG_A1 * OP1_MULT;
    MEM(15) = TAG_ATOM * TAG_MULT + 2;
    MEM(16) = OP_PROCEED * OP_MULT;

    MEM(19) = OP_TRUST * OP_MULT;
    MEM(20) = OP_GET_CONST * OP_MULT;
    MEM(21) = TAG_ATOM * TAG_MULT + 1;
    MEM(22) = OP_GET_CONST * OP_MULT + REG_A1 * OP1_MULT;
    MEM(23) = TAG_ATOM * TAG_MULT + 3;
    MEM(24) = OP_PROCEED * OP_MULT;
END;

/* --------------------------------------------------------
 * Test 10: allocate/deallocate
 * wrap(X) :- parent(X, Y).
 * parent(bob, ann). (single fact)
 * ?- wrap(bob).
 *
 * wrap/1 uses ALLOCATE 0 (no locals, but saves CP) then
 * calls parent/2, then DEALLOCATE + PROCEED.
 *
 * Layout:
 *   0-1: PUT_CONST A0, bob       query
 *   2-3: CALL 6                  call wrap/1
 *   4:   HALT
 *   6:   ALLOCATE 0              wrap/1 entry
 *   7:   PUT_VAR X0, A1          create Y
 *   8-9: CALL 12                 call parent/2
 *   10:  DEALLOCATE              restore CP
 *   11:  PROCEED                 return from wrap
 *   12-13: GET_CONST A0, bob     parent(bob, ann)
 *   14-15: GET_CONST A1, ann
 *   16:  PROCEED
 * -------------------------------------------------------- */

LOAD_ALLOC_TEST: PROC;
    /* Query: ?- wrap(bob). */
    MEM(0)  = OP_PUT_CONST * OP_MULT;
    MEM(1)  = TAG_ATOM * TAG_MULT + 1;
    MEM(2)  = OP_CALL * OP_MULT;
    MEM(3)  = 6;
    MEM(4)  = OP_HALT * OP_MULT;

    /* wrap/1: wrap(X) :- parent(X, Y). */
    MEM(6)  = OP_ALLOCATE * OP_MULT;
    MEM(7)  = OP_PUT_VAR * OP_MULT + REG_X0 * OP1_MULT + REG_A1;
    MEM(8)  = OP_CALL * OP_MULT;
    MEM(9)  = 12;
    MEM(10) = OP_DEALLOCATE * OP_MULT;
    MEM(11) = OP_PROCEED * OP_MULT;

    /* parent(bob, ann). */
    MEM(12) = OP_GET_CONST * OP_MULT;
    MEM(13) = TAG_ATOM * TAG_MULT + 1;
    MEM(14) = OP_GET_CONST * OP_MULT + REG_A1 * OP1_MULT;
    MEM(15) = TAG_ATOM * TAG_MULT + 2;
    MEM(16) = OP_PROCEED * OP_MULT;
END;

/* --------------------------------------------------------
 * Test 11: ancestor/2 with recursion
 *
 * parent(bob, ann).
 * parent(ann, liz).
 * ancestor(X, Y) :- parent(X, Y).
 * ancestor(X, Y) :- parent(X, Z), ancestor(Z, Y).
 * ?- ancestor(bob, liz).
 *
 * Should succeed via recursive path:
 *   ancestor(bob, liz) -> parent(bob, Z) binds Z=ann,
 *   then ancestor(ann, liz) -> parent(ann, liz) succeeds.
 *
 * Layout:
 *   0-1: PUT_CONST A0, bob          query
 *   2-3: PUT_CONST A1, liz
 *   4-5: CALL 8                     call ancestor
 *   6:   HALT
 *
 *   8-9: TRY 12                     ancestor entry, alt=clause2
 *   10-11: EXECUTE 24               clause1: tail call parent
 *
 *   12:  TRUST                      clause2 entry
 *   13:  ALLOCATE 1                 Y0 = saved Y
 *   14:  GET_Y_VAR Y0, A1           save Y into Y0
 *   15:  PUT_VAR X0, A1             create Z in A1
 *   16-17: CALL 24                  parent(X, Z)
 *   18:  GET_VAR X2, A1             X2 = Z ref (from A1)
 *   19:  PUT_Y_VAL Y0, A1           A1 = Y (from Y0)
 *   20:  PUT_VAL X2, A0             A0 = Z
 *   21:  DEALLOCATE
 *   22-23: EXECUTE 8                tail call ancestor(Z, Y)
 *
 *   24-25: TRY 31                   parent entry, alt=clause2
 *   26-27: GET_CONST A0, bob        parent(bob, ann)
 *   28-29: GET_CONST A1, ann
 *   30:  PROCEED
 *   31:  TRUST                      parent clause2
 *   32-33: GET_CONST A0, ann        parent(ann, liz)
 *   34-35: GET_CONST A1, liz
 *   36:  PROCEED
 * -------------------------------------------------------- */

LOAD_ANCESTOR_TEST: PROC;
    /* Query: ?- ancestor(bob, liz). */
    MEM(0)  = OP_PUT_CONST * OP_MULT;
    MEM(1)  = TAG_ATOM * TAG_MULT + 1;                 /* bob */
    MEM(2)  = OP_PUT_CONST * OP_MULT + REG_A1 * OP1_MULT;
    MEM(3)  = TAG_ATOM * TAG_MULT + 4;                 /* liz */
    MEM(4)  = OP_CALL * OP_MULT;
    MEM(5)  = 8;                                        /* ancestor entry */
    MEM(6)  = OP_HALT * OP_MULT;

    /* ancestor/2 entry */
    MEM(8)  = OP_TRY * OP_MULT;
    MEM(9)  = 12;                                       /* alt: clause2 */

    /* clause1: ancestor(X,Y) :- parent(X,Y). */
    MEM(10) = OP_EXECUTE * OP_MULT;
    MEM(11) = 24;                                       /* tail call parent */

    /* clause2: ancestor(X,Y) :- parent(X,Z), ancestor(Z,Y). */
    MEM(12) = OP_TRUST * OP_MULT;
    MEM(13) = OP_ALLOCATE * OP_MULT + 1 * OP1_MULT;   /* ALLOCATE 1 */
    MEM(14) = OP_GET_Y_VAR * OP_MULT + 0 * OP1_MULT + REG_A1; /* GET_Y_VAR Y0, A1 */
    MEM(15) = OP_PUT_VAR * OP_MULT + REG_X0 * OP1_MULT + REG_A1; /* PUT_VAR X0, A1 */
    MEM(16) = OP_CALL * OP_MULT;
    MEM(17) = 24;                                       /* call parent */
    MEM(18) = OP_GET_VAR * OP_MULT + REG_X2 * OP1_MULT + REG_A1; /* GET_VAR X2, A1 */
    MEM(19) = OP_PUT_Y_VAL * OP_MULT + 0 * OP1_MULT + REG_A1; /* PUT_Y_VAL Y0, A1 */
    MEM(20) = OP_PUT_VAL * OP_MULT + REG_X2 * OP1_MULT + REG_A0; /* PUT_VAL X2, A0 */
    MEM(21) = OP_DEALLOCATE * OP_MULT;
    MEM(22) = OP_EXECUTE * OP_MULT;
    MEM(23) = 8;                                        /* tail call ancestor */

    /* parent/2 entry */
    MEM(24) = OP_TRY * OP_MULT;
    MEM(25) = 31;                                       /* alt: clause2 */

    /* parent(bob, ann). */
    MEM(26) = OP_GET_CONST * OP_MULT;
    MEM(27) = TAG_ATOM * TAG_MULT + 1;                 /* bob */
    MEM(28) = OP_GET_CONST * OP_MULT + REG_A1 * OP1_MULT;
    MEM(29) = TAG_ATOM * TAG_MULT + 2;                 /* ann */
    MEM(30) = OP_PROCEED * OP_MULT;

    /* parent(ann, liz). */
    MEM(31) = OP_TRUST * OP_MULT;
    MEM(32) = OP_GET_CONST * OP_MULT;
    MEM(33) = TAG_ATOM * TAG_MULT + 2;                 /* ann */
    MEM(34) = OP_GET_CONST * OP_MULT + REG_A1 * OP1_MULT;
    MEM(35) = TAG_ATOM * TAG_MULT + 4;                 /* liz */
    MEM(36) = OP_PROCEED * OP_MULT;
END;

/* --------------------------------------------------------
 * Test 12: ancestor(bob, X) -- find all answers
 *
 * Same clauses as LOAD_ANCESTOR_TEST, but query uses
 * PUT_VAR for X and a write/nl/fail loop.
 *
 * Expected output:
 *   ann   (ancestor clause 1 -> parent(bob, ann))
 *   liz   (ancestor clause 2 -> parent(bob,ann), ancestor(ann,liz))
 *   FAIL  (no more choice points)
 * -------------------------------------------------------- */

LOAD_ANCESTOR_ALL: PROC;
    /* Query: ?- ancestor(bob, X), write(X), nl, fail. */
    MEM(0)  = OP_PUT_CONST * OP_MULT;
    MEM(1)  = TAG_ATOM * TAG_MULT + 1;                 /* bob */
    MEM(2)  = OP_PUT_VAR * OP_MULT + REG_X0 * OP1_MULT + REG_A1; /* PUT_VAR X0, A1 */
    MEM(3)  = OP_CALL * OP_MULT;
    MEM(4)  = 8;                                        /* ancestor entry */
    MEM(5)  = OP_B_WRITE * OP_MULT + REG_A1 * OP1_MULT; /* B_WRITE A1 */
    MEM(6)  = OP_B_NL * OP_MULT;
    MEM(7)  = OP_FAIL * OP_MULT;

    /* ancestor/2 entry (same as LOAD_ANCESTOR_TEST) */
    MEM(8)  = OP_TRY * OP_MULT;
    MEM(9)  = 12;

    MEM(10) = OP_EXECUTE * OP_MULT;
    MEM(11) = 24;

    MEM(12) = OP_TRUST * OP_MULT;
    MEM(13) = OP_ALLOCATE * OP_MULT + 1 * OP1_MULT;
    MEM(14) = OP_GET_Y_VAR * OP_MULT + 0 * OP1_MULT + REG_A1;
    MEM(15) = OP_PUT_VAR * OP_MULT + REG_X0 * OP1_MULT + REG_A1;
    MEM(16) = OP_CALL * OP_MULT;
    MEM(17) = 24;
    MEM(18) = OP_GET_VAR * OP_MULT + REG_X2 * OP1_MULT + REG_A1;
    MEM(19) = OP_PUT_Y_VAL * OP_MULT + 0 * OP1_MULT + REG_A1;
    MEM(20) = OP_PUT_VAL * OP_MULT + REG_X2 * OP1_MULT + REG_A0;
    MEM(21) = OP_DEALLOCATE * OP_MULT;
    MEM(22) = OP_EXECUTE * OP_MULT;
    MEM(23) = 8;

    /* parent/2 entry */
    MEM(24) = OP_TRY * OP_MULT;
    MEM(25) = 31;

    MEM(26) = OP_GET_CONST * OP_MULT;
    MEM(27) = TAG_ATOM * TAG_MULT + 1;
    MEM(28) = OP_GET_CONST * OP_MULT + REG_A1 * OP1_MULT;
    MEM(29) = TAG_ATOM * TAG_MULT + 2;
    MEM(30) = OP_PROCEED * OP_MULT;

    MEM(31) = OP_TRUST * OP_MULT;
    MEM(32) = OP_GET_CONST * OP_MULT;
    MEM(33) = TAG_ATOM * TAG_MULT + 2;
    MEM(34) = OP_GET_CONST * OP_MULT + REG_A1 * OP1_MULT;
    MEM(35) = TAG_ATOM * TAG_MULT + 4;
    MEM(36) = OP_PROCEED * OP_MULT;
END;

MAIN: PROC;
END;
