; memory.plsw — Memory map constants for the LAM
;
; The LAM address space is divided into fixed-base contiguous regions.
; All addresses and sizes are in cells (24-bit words), not bytes.
;
; See docs/vm-spec.md section 2 for the full specification.

; --- Region base addresses ---

CODE_BASE       EQU 0x0000
ATOM_BASE       EQU 0x0100
FUNC_BASE       EQU 0x0180
REG_BASE        EQU 0x0200
HEAP_BASE       EQU 0x0218
TRAIL_BASE      EQU 0x1218
ENV_BASE        EQU 0x1618
CP_BASE         EQU 0x1A18

; --- Region sizes (cells) ---

CODE_SIZE       EQU 256
ATOM_SIZE       EQU 128
FUNC_SIZE       EQU 128
REG_SIZE        EQU 24
HEAP_SIZE       EQU 4096
TRAIL_SIZE      EQU 1024
ENV_SIZE        EQU 1024
CP_SIZE         EQU 1024

; Total cells: 7704 (0x1E18)
MEM_TOTAL       EQU 0x1E18

; --- Register file offsets (relative to REG_BASE) ---

; Argument registers
REG_A0          EQU 0
REG_A1          EQU 1
REG_A2          EQU 2
REG_A3          EQU 3
REG_A4          EQU 4
REG_A5          EQU 5
REG_A6          EQU 6
REG_A7          EQU 7

; Temporary registers
REG_X0          EQU 8
REG_X1          EQU 9
REG_X2          EQU 10
REG_X3          EQU 11
REG_X4          EQU 12
REG_X5          EQU 13
REG_X6          EQU 14
REG_X7          EQU 15

; Special registers
REG_PC          EQU 16
REG_CP          EQU 17
REG_HP          EQU 18
REG_TR          EQU 19
REG_EP          EQU 20
REG_BP          EQU 21
REG_MODE        EQU 22
REG_UP          EQU 23

; --- Convenience ---
;
; Register access:  mem[REG_BASE + REG_xx]
; Heap cell at H:   mem[HEAP_BASE + H]   (but H in payload is absolute)
;
; Note: heap/trail/stack pointers (HP, TR, EP, BP) hold absolute
; cell addresses, not offsets. On init:
;   HP = HEAP_BASE
;   TR = TRAIL_BASE
;   EP = ENV_BASE
;   BP = CP_BASE
;
; Overflow check:  pointer >= BASE + SIZE  means overflow.
