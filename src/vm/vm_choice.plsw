/* vm_choice.plsw -- Choice-point frame operations
 *
 * BP convention: BP points to the NEXT FREE SLOT on the
 * choice-point stack (like HP for the heap). The most recent
 * frame is at BP - CP_FRAME_SIZE. BP == CP_BASE means no
 * choice points exist.
 *
 * prev_BP in each frame stores the BP value BEFORE the push
 * (i.e., the frame's own base address). Pop restores BP to
 * prev_BP, which removes the frame.
 */
%DEFINE LIBRARY;

%INCLUDE memory;
%INCLUDE frames;
%INCLUDE vmglob;

CP_READ: PROC(BASE INT, OFF INT) RETURNS(INT);
    RETURN(MEM(BASE + OFF));
END;

CP_WRITE: PROC(BASE INT, OFF INT, VAL INT);
    MEM(BASE + OFF) = VAL;
END;

/* Push a choice-point frame at current BP, advance BP.
 * ALT = code address of next alternative clause. */
CP_PUSH: PROC(ALT INT);
    DCL M_CPOV(14) CHAR STATIC INIT('CP overflow  ');
    DCL FB INT;
    FB = REG_GET(REG_BP);
    IF (FB + CP_FRAME_SIZE > CP_BASE + CP_STKSZ) THEN DO;
        CALL UART_PUTS(ADDR(M_CPOV));
        G_RUNNING = 0;
        RETURN;
    END;
    CALL CP_WRITE(FB, CPF_PREV_BP,  FB);
    CALL CP_WRITE(FB, CPF_SAVED_CP, REG_GET(REG_CP));
    CALL CP_WRITE(FB, CPF_SAVED_EP, REG_GET(REG_EP));
    CALL CP_WRITE(FB, CPF_SAVED_HP, REG_GET(REG_HP));
    CALL CP_WRITE(FB, CPF_SAVED_TR, REG_GET(REG_TR));
    CALL CP_WRITE(FB, CPF_NEXT_ALT, ALT);
    CALL CP_WRITE(FB, CPF_SAVED_A0, REG_GET(REG_A0));
    CALL CP_WRITE(FB, CPF_SAVED_A1, REG_GET(REG_A1));
    CALL CP_WRITE(FB, CPF_SAVED_A2, REG_GET(REG_A2));
    CALL CP_WRITE(FB, CPF_SAVED_A3, REG_GET(REG_A3));
    CALL CP_WRITE(FB, CPF_SAVED_A4, REG_GET(REG_A4));
    CALL CP_WRITE(FB, CPF_SAVED_A5, REG_GET(REG_A5));
    CALL CP_WRITE(FB, CPF_SAVED_A6, REG_GET(REG_A6));
    CALL CP_WRITE(FB, CPF_SAVED_A7, REG_GET(REG_A7));
    CALL REG_SET(REG_BP, FB + CP_FRAME_SIZE);
END;

/* Restore state from most recent frame WITHOUT popping.
 * Used by FAIL to jump to the alternative.
 * Unwinds trail, resets HP, restores A0-A7 and CP/EP.
 * Returns the next_alt address. BP unchanged. */
CP_RESTORE: PROC RETURNS(INT);
    DCL FB INT;
    DCL SAVED_TR INT;
    DCL SAVED_HP INT;
    FB = REG_GET(REG_BP) - CP_FRAME_SIZE;

    SAVED_TR = CP_READ(FB, CPF_SAVED_TR);
    SAVED_HP = CP_READ(FB, CPF_SAVED_HP);
    CALL TRAIL_UNWIND(SAVED_TR);
    CALL REG_SET(REG_HP, SAVED_HP);

    CALL REG_SET(REG_CP, CP_READ(FB, CPF_SAVED_CP));
    CALL REG_SET(REG_EP, CP_READ(FB, CPF_SAVED_EP));
    CALL REG_SET(REG_A0, CP_READ(FB, CPF_SAVED_A0));
    CALL REG_SET(REG_A1, CP_READ(FB, CPF_SAVED_A1));
    CALL REG_SET(REG_A2, CP_READ(FB, CPF_SAVED_A2));
    CALL REG_SET(REG_A3, CP_READ(FB, CPF_SAVED_A3));
    CALL REG_SET(REG_A4, CP_READ(FB, CPF_SAVED_A4));
    CALL REG_SET(REG_A5, CP_READ(FB, CPF_SAVED_A5));
    CALL REG_SET(REG_A6, CP_READ(FB, CPF_SAVED_A6));
    CALL REG_SET(REG_A7, CP_READ(FB, CPF_SAVED_A7));

    RETURN(CP_READ(FB, CPF_NEXT_ALT));
END;

/* Restore state AND pop the frame. Used by TRUST. */
CP_POP: PROC RETURNS(INT);
    DCL ALT INT;
    DCL FB INT;
    ALT = CP_RESTORE();
    FB = REG_GET(REG_BP) - CP_FRAME_SIZE;
    CALL REG_SET(REG_BP, CP_READ(FB, CPF_PREV_BP));
    RETURN(ALT);
END;


MAIN: PROC;
END;
