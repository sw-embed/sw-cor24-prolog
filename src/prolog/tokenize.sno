* tokenize.sno -- Prolog tokenizer for the LAM compiler
*
* Reads Prolog source from INPUT (one line at a time).
* Outputs one token per line in the format:
*   TYPE VALUE
* where TYPE is one of:
*   ATOM   -- lowercase identifier (bob, parent, ancestor)
*   VAR    -- variable (X, Y, _Temp)
*   INT    -- integer literal (42, 0)
*   DOT    -- .  (clause terminator)
*   COMMA  -- ,  (conjunction)
*   LPAREN -- (
*   RPAREN -- )
*   NECK   -- :-  (rule operator)
*   QUERY  -- ?-  (query operator)
*   CUT    -- !   (cut)
*   EOF    -- end of input
*
* Usage:
*   run-snobol4.sh src/prolog/tokenize.sno source.pl
*
* Character classes for SPAN/BREAK
       LOWER = 'abcdefghijklmnopqrstuvwxyz'
       UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ_'
       DIGIT = '0123456789'
       ALNUM = LOWER UPPER DIGIT
       SPACE = ' '
*
* Read next line
READ   LINE = INPUT                     :F(DONE)
*      Skip empty lines
       IDENT(LINE,'')                   :S(READ)
*      Skip comment lines (% to end)
       LINE '%' REM                     :S(READ)
*
* Scan tokens from LINE
SCAN   IDENT(LINE,'')                   :S(READ)
*      Skip leading whitespace
SKWS   LINE SPAN(SPACE) =              :S(SKWS)
       IDENT(LINE,'')                   :S(READ)
*
*      Try :- (neck)
       LINE ':-' =                      :F(T1)
       OUTPUT = 'NECK :-'              :(SCAN)
*
*      Try ?- (query)
T1     LINE '?-' =                      :F(T2)
       OUTPUT = 'QUERY ?-'            :(SCAN)
*
*      Try single-char punctuation
T2     LINE LEN(1) . CH =              :F(READ)
*
*      Dot
       IDENT(CH,'.')                    :F(T3)
       OUTPUT = 'DOT .'               :(SCAN)
*
*      Comma
T3     IDENT(CH,',')                    :F(T4)
       OUTPUT = 'COMMA ,'             :(SCAN)
*
*      Left paren
T4     IDENT(CH,'(')                    :F(T5)
       OUTPUT = 'LPAREN ('            :(SCAN)
*
*      Right paren
T5     IDENT(CH,')')                    :F(T6)
       OUTPUT = 'RPAREN )'            :(SCAN)
*
*      Cut
T6     IDENT(CH,'!')                    :F(T7)
       OUTPUT = 'CUT !'               :(SCAN)
*
*      Comment (% -- skip rest of line)
T7     IDENT(CH,'%')                    :F(T8)
       LINE =                          :(READ)
*
*      Check if it starts a lowercase identifier (atom)
T8     CH SPAN(LOWER) . L              :F(T9)
*      Put the char back and extract full identifier
       LINE = CH LINE
       LINE SPAN(ALNUM) . TOK =        :F(READ)
       OUTPUT = 'ATOM ' TOK           :(SCAN)
*
*      Check if it starts an uppercase/underscore (variable)
T9     CH SPAN(UPPER) . L              :F(T10)
       LINE = CH LINE
       LINE SPAN(ALNUM) . TOK =        :F(VONE)
       OUTPUT = 'VAR ' TOK            :(SCAN)
VONE   OUTPUT = 'VAR ' CH             :(SCAN)
*
*      Check if it starts a digit (integer)
T10    CH SPAN(DIGIT) . L              :F(TBAD)
       LINE = CH LINE
       LINE SPAN(DIGIT) . TOK =        :F(IONE)
       OUTPUT = 'INT ' TOK            :(SCAN)
IONE   OUTPUT = 'INT ' CH             :(SCAN)
*
*      Unknown character -- skip
TBAD   OUTPUT = 'ERR ' CH             :(SCAN)
*
DONE   OUTPUT = 'EOF'
END
