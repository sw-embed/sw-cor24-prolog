* tokenize.sno -- Prolog tokenizer for the LAM compiler
*
* Reads Prolog source via RAWINPUT (case-preserving).
* Outputs one token per line:  TYPE VALUE
*
* Strategy: extract first char with LEN(1), classify it,
* then SPAN the rest of multi-char tokens. LEN(1) is
* anchored to position 0 (avoids unanchored SPAN issues).
*
READ   LINE = RAWINPUT                  :F(DONE)
*
SCAN   IDENT(LINE,'')                   :S(READ)
*      Skip whitespace
       LINE LEN(1) . CH                :F(READ)
       IDENT(CH,' ')                    :F(SK2)
       LINE ' ' = ''                   :(SCAN)
SK2    IDENT(CH,'	')                  :F(CHCK)
       LINE '	' = ''                  :(SCAN)
*
*      Classify first character
CHCK   IDENT(CH,'%')                    :F(CK1)
       LINE = ''                       :(READ)
*
*      Two-char operators: must check before consuming CH
CK1    LINE ':-' = ''                  :F(CK2)
       OUTPUT = 'NECK :-'             :(SCAN)
CK2    LINE '?-' = ''                  :F(CK3)
       OUTPUT = 'QUERY ?-'            :(SCAN)
*
*      Lowercase -> atom
CK3    'abcdefghijklmnopqrstuvwxyz' CH :F(CK4)
       LINE LEN(1) = ''
       LINE SPAN('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_') . REST = '' :F(A1)
       OUTPUT = 'ATOM ' CH REST       :(SCAN)
A1     OUTPUT = 'ATOM ' CH            :(SCAN)
*
*      Uppercase -> variable
CK4    'ABCDEFGHIJKLMNOPQRSTUVWXYZ' CH :F(CK5)
       LINE LEN(1) = ''
       LINE SPAN('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_') . REST = '' :F(V1)
       OUTPUT = 'VAR ' CH REST        :(SCAN)
V1     OUTPUT = 'VAR ' CH             :(SCAN)
*
*      Underscore -> variable
CK5    IDENT(CH,'_')                    :F(CK6)
       LINE LEN(1) = ''
       LINE SPAN('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_') . REST = '' :F(U1)
       OUTPUT = 'VAR _' REST          :(SCAN)
U1     OUTPUT = 'VAR _'               :(SCAN)
*
*      Digit -> integer
CK6    '0123456789' CH                  :F(CK7)
       LINE LEN(1) = ''
       LINE SPAN('0123456789') . REST = '' :F(I1)
       OUTPUT = 'INT ' CH REST        :(SCAN)
I1     OUTPUT = 'INT ' CH             :(SCAN)
*
*      Single-char punctuation
CK7    LINE LEN(1) = ''
       IDENT(CH,'.')                    :F(P1)
       OUTPUT = 'DOT .'               :(SCAN)
P1     IDENT(CH,',')                    :F(P2)
       OUTPUT = 'COMMA ,'             :(SCAN)
P2     IDENT(CH,'(')                    :F(P3)
       OUTPUT = 'LPAREN ('            :(SCAN)
P3     IDENT(CH,')')                    :F(P4)
       OUTPUT = 'RPAREN )'            :(SCAN)
P4     IDENT(CH,'!')                    :F(PERR)
       OUTPUT = 'CUT !'               :(SCAN)
*
PERR   OUTPUT = 'ERR ' CH             :(SCAN)
*
DONE   OUTPUT = 'EOF'
END
