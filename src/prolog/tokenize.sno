* tokenize.sno -- Prolog tokenizer for the LAM compiler
*
* Reads Prolog source via RAWINPUT (case-preserving).
* Outputs one token per line:  TYPE VALUE
*
* Uses LEN(1) peek for first-char classification, then
* BREAK on delimiters to consume the rest of multi-char
* tokens (SPAN is unanchored, BREAK is anchored).
*
READ   LINE = RAWINPUT                  :F(DONE)
*
SCAN   IDENT(LINE,'')                   :S(READ)
*      Skip whitespace
       LINE ' ' = ''                   :S(SCAN)
       IDENT(LINE,'')                   :S(READ)
*
*      Two-char operators (check before consuming)
       LINE ':-' = ''                  :F(CK2)
       OUTPUT = 'NECK :-'             :(SCAN)
CK2    LINE '?-' = ''                  :F(CK3)
       OUTPUT = 'QUERY ?-'            :(SCAN)
*
*      Peek at first char
CK3    LINE LEN(1) . CH                :F(READ)
*
*      Comment
       IDENT(CH,'%')                    :F(CK4)
       LINE = ''                       :(READ)
*
*      Lowercase -> atom
CK4    'abcdefghijklmnopqrstuvwxyz' CH :F(CK5)
       LINE BREAK(' ,().:;!?%-') . TOK = '' :F(A1)
       OUTPUT = 'ATOM ' TOK           :(SCAN)
A1     LINE REM . TOK = ''
       OUTPUT = 'ATOM ' TOK           :(SCAN)
*
*      Uppercase -> variable
CK5    'ABCDEFGHIJKLMNOPQRSTUVWXYZ' CH :F(CK6)
       LINE BREAK(' ,().:;!?%-') . TOK = '' :F(V1)
       OUTPUT = 'VAR ' TOK            :(SCAN)
V1     LINE REM . TOK = ''
       OUTPUT = 'VAR ' TOK            :(SCAN)
*
*      Underscore -> variable
CK6    IDENT(CH,'_')                    :F(CK7)
       LINE BREAK(' ,().:;!?%-') . TOK = '' :F(U1)
       OUTPUT = 'VAR ' TOK            :(SCAN)
U1     LINE REM . TOK = ''
       OUTPUT = 'VAR ' TOK            :(SCAN)
*
*      Digit -> integer
CK7    '0123456789' CH                  :F(CK8)
       LINE BREAK(' ,().:;!?%-') . TOK = '' :F(I1)
       OUTPUT = 'INT ' TOK            :(SCAN)
I1     LINE REM . TOK = ''
       OUTPUT = 'INT ' TOK            :(SCAN)
*
*      Single-char punctuation (consume it)
CK8    LINE LEN(1) = ''
       IDENT(CH,'.')                    :F(P1)
       OUTPUT = 'DOT .'               :(SCAN)
P1     IDENT(CH,',')                    :F(P2)
       OUTPUT = 'COMMA ,'             :(SCAN)
P2     IDENT(CH,'(')                    :F(P3)
       OUTPUT = 'LPAREN ('            :(SCAN)
P3     IDENT(CH,')')                    :F(P4)
       OUTPUT = 'RPAREN )'            :(SCAN)
P4     IDENT(CH,'!')                    :F(PERR)
       OUTPUT = 'CUT !'               :(SCAN)
*
PERR   OUTPUT = 'ERR ' CH             :(SCAN)
*
DONE   OUTPUT = 'EOF'
END
