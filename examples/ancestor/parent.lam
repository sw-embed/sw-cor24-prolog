.atom 0 nil
.atom 1 bob
.atom 2 ann
.atom 3 joe
.atom 4 liz
.atom 5 parent
.atom 6 ancestor
.atom 7 red
.atom 8 green
.atom 9 blue

    EXECUTE query


parent_c1:
    GET_CONST A0, atom(bob)
    GET_CONST A1, atom(ann)
    PROCEED

parent_c2:
    GET_CONST A0, atom(ann)
    GET_CONST A1, atom(liz)
    PROCEED

query:
    PUT_CONST A0, atom(bob)
    PUT_CONST A1, atom(ann)
    CALL parent_c1
    HALT
